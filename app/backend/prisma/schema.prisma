generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MessageRole {
  user
  assistant
  system
}

enum ConversationStatus {
  active
  archived
}

enum FileStatus {
  uploaded
  processing
  processed
  failed
}

enum MemoryType {
  summary
  preference
  fact
  decision
  goal
}

enum WorkspaceMemoryType {
  fact
  preference
  decision
  goal
}

enum PersistentMemoryScope {
  GLOBAL
  WORKSPACE
  CONVERSATION
}

enum PersistentMemoryType {
  INSTRUCTION
  PREFERENCE
  FACT
  CONSTRAINT
  PROJECT_CONTEXT
  SUMMARY
}

enum PersistentMemoryStatus {
  ACTIVE
  ARCHIVED
}

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  password           String
  conversations      Conversation[]
  knowledgeFiles     KnowledgeFile[]
  workspaceMemories  WorkspaceMemory[]
  persistentMemories PersistentMemory[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model Conversation {
  id                 String                      @id @default(cuid())
  title              String                      @default("New Conversation")
  status             ConversationStatus          @default(active)
  userId             String
  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages           Message[]
  attachedFiles      ConversationKnowledgeFile[]
  memories           ConversationMemory[]
  persistentMemories PersistentMemory[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@index([userId])
}

model PersistentMemory {
  id             String                 @id @default(cuid())
  userId         String
  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId    String                 @default("default")
  conversationId String?
  conversation   Conversation?          @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  content        String                 @db.Text
  type           PersistentMemoryType   @default(FACT)
  scope          PersistentMemoryScope  @default(WORKSPACE)
  category       String                 @default("workspace_instructions")
  priority       Int                    @default(5)
  status         PersistentMemoryStatus @default(ACTIVE)
  source         String                 @default("user_explicit")
  isPinned       Boolean                @default(false)
  lastUsedAt     DateTime?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([userId])
  @@index([userId, workspaceId])
  @@index([userId, scope, status])
  @@index([conversationId])
}

model Message {
  id             String                 @id @default(cuid())
  conversationId String
  conversation   Conversation           @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String                 @db.Text
  metadata       Json?
  attachments    MessageKnowledgeFile[]
  createdAt      DateTime               @default(now())

  @@index([conversationId])
}

model KnowledgeFile {
  id                 String                      @id @default(cuid())
  filename           String
  originalName       String
  extension          String
  mimeType           String
  size               Int
  path               String
  hash               String
  status             FileStatus                  @default(uploaded)

  lastAccessedAt     DateTime?
  processedAt        DateTime?
  tokenCount         Int?
  pageCount          Int?
  language           String?
  summary            String?
  vectorNamespace    String?

  userId             String
  user               User                        @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations      ConversationKnowledgeFile[]
  messageAttachments MessageKnowledgeFile[]
  chunks             KnowledgeChunk[]

  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  @@unique([userId, hash])
  @@index([userId])
}

model MessageKnowledgeFile {
  id         String        @id @default(cuid())

  messageId  String
  message    Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)

  fileId     String
  file       KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  source     String        @default("existing") // "uploaded" | "existing"
  attachedAt DateTime      @default(now())

  @@unique([messageId, fileId])
  @@index([messageId])
  @@index([fileId])
}


model ConversationKnowledgeFile {
  id             String        @id @default(cuid())

  conversationId String
  conversation   Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  fileId         String
  file           KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  attachedAt     DateTime      @default(now())
  isPinned       Boolean       @default(true)

  @@unique([conversationId, fileId])
  @@index([conversationId])
  @@index([fileId])
}

model KnowledgeChunk {
  id            String        @id @default(cuid())

  fileId        String
  file          KnowledgeFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  chunkIndex    Int
  page          Int?
  content       String        @db.Text
  tokenEstimate Int

  embeddingId   String?
  embeddedAt    DateTime?

  createdAt     DateTime      @default(now())

  @@index([fileId])
  @@index([chunkIndex])
}

model ConversationMemory {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  content        String       @db.Text
  type           MemoryType   @default(fact)
  importance     Float        @default(0.5)
  isPinned       Boolean      @default(false)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId])
}

model WorkspaceMemory {
  id          String              @id @default(cuid())

  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  content     String              @db.Text
  type        WorkspaceMemoryType @default(fact)

  importance  Float               @default(0.5)

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([userId, type])
}




