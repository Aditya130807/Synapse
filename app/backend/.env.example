# Server
PORT=5000
NODE_ENV=development

# CORS
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/synapse

# JWT
JWT_SECRET=synapse-dev-secret-change-in-production
JWT_EXPIRES_IN=7d

# ─── AI Provider ───────────────────────────────────────────────────────────────
# Set AI_PROVIDER to one of: omniroute | openrouter | gemini | openai | anthropic | groq | ollama | azure_openai
# Only the credentials for the active provider need to be supplied.

AI_PROVIDER=omniroute

# OmniRoute (Local OpenAI-compatible provider)
OMNIROUTE_BASE_URL=http://localhost:20128/v1
OMNIROUTE_API_KEY=

# Agent Model Profiles & Fallbacks
GENERAL_AGENT_MODEL=auto/best-fast
GENERAL_AGENT_FALLBACK_MODELS=auto/fast,auto/chat

CODING_AGENT_MODEL=auto/best-coding
CODING_AGENT_FALLBACK_MODELS=auto/coding:reliable,auto/coding:fast

RESEARCH_AGENT_MODEL=auto/best-reasoning
RESEARCH_AGENT_FALLBACK_MODELS=auto/pro-reasoning,auto/reasoning

DOCUMENT_AGENT_MODEL=aug/sonnet4.6-500k
DOCUMENT_AGENT_FALLBACK_MODELS=auto/smart,oc/deepseek-v4-flash-free

SYNTHESIS_AGENT_MODEL=auto/smart
SYNTHESIS_AGENT_FALLBACK_MODELS=auto/pro-reasoning,auto/reasoning

ENABLE_GENERAL_AGENT_EMERGENCY_FALLBACK=true

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Google Gemini (set AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (set AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic / Claude (set AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Groq (set AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama — local models (set AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Azure OpenAI (set AI_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
